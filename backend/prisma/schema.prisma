// ============================================================================
//  CRM Pro - Schema Prisma (PostgreSQL / Neon)
// ============================================================================
//  Documentation complete : docs/DATABASE.md
//
//  Points importants :
//   - DATABASE_URL : URL poolee Neon (host contenant "-pooler"), utilisee par
//     l'application a l'execution (compatible serverless / Vercel).
//   - DIRECT_URL   : URL directe Neon (sans "-pooler"), utilisee uniquement par
//     la CLI Prisma pour les migrations.
//   - Les noms de champs restent en snake_case pour garder exactement le meme
//     format JSON que l'API historique et que le mode de secours JSON.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" pour le poste de dev, "rhel-openssl-3.0.x" pour les fonctions Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
//  Utilisateurs (authentification JWT)
// ----------------------------------------------------------------------------
model User {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255) // hash bcrypt, jamais renvoye par l'API
  role       String   @default("user") @db.VarChar(50) // "admin" | "user"
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  chat_messages ChatMessage[]

  @@map("users")
}

// ----------------------------------------------------------------------------
//  Clients
// ----------------------------------------------------------------------------
model Client {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  telephone  String?  @db.VarChar(50)
  entreprise String?  @db.VarChar(255)
  statut     String   @default("actif") @db.VarChar(50) // "actif" | "inactif"
  notes      String?  @db.Text
  source     String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  interactions  Interaction[]
  opportunities Opportunity[]

  @@index([email])
  @@index([statut])
  @@index([nom])
  @@map("clients")
}

// ----------------------------------------------------------------------------
//  Prospects
// ----------------------------------------------------------------------------
model Prospect {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  telephone  String?  @db.VarChar(50)
  entreprise String?  @db.VarChar(255)
  source     String?  @default("site_web") @db.VarChar(100)
  statut     String   @default("nouveau") @db.VarChar(50) // "nouveau" | "contacte" | "converti"
  notes      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  interactions Interaction[]

  @@index([statut])
  @@index([nom])
  @@map("prospects")
}
