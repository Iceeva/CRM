// ============================================================================
//  CRM Pro - Schema Prisma (PostgreSQL / Neon)
// ============================================================================
//  Documentation complete : docs/DATABASE.md
//
//  Points importants :
//   - DATABASE_URL : URL poolee Neon (host contenant "-pooler"), utilisee par
//     l'application a l'execution (compatible serverless / Vercel).
//   - DIRECT_URL   : URL directe Neon (sans "-pooler"), utilisee uniquement par
//     la CLI Prisma pour les migrations.
//   - Les noms de champs restent en snake_case pour garder exactement le meme
//     format JSON que l'API historique et que le mode de secours JSON.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" pour le poste de dev, "rhel-openssl-3.0.x" pour les fonctions Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
//  Utilisateurs (authentification JWT)
// ----------------------------------------------------------------------------
model User {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  password   String   @db.VarChar(255) // hash bcrypt, jamais renvoye par l'API
  role       String   @default("user") @db.VarChar(50) // "admin" | "user"
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  chat_messages ChatMessage[]

  @@map("users")
}

// ----------------------------------------------------------------------------
//  Clients
// ----------------------------------------------------------------------------
model Client {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  telephone  String?  @db.VarChar(50)
  entreprise String?  @db.VarChar(255)
  statut     String   @default("actif") @db.VarChar(50) // "actif" | "inactif"
  notes      String?  @db.Text
  source     String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  interactions  Interaction[]
  opportunities Opportunity[]

  @@index([email])
  @@index([statut])
  @@index([nom])
  @@map("clients")
}

// ----------------------------------------------------------------------------
//  Prospects
// ----------------------------------------------------------------------------
model Prospect {
  id         String   @id @db.VarChar(64)
  nom        String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  telephone  String?  @db.VarChar(50)
  entreprise String?  @db.VarChar(255)
  source     String?  @default("site_web") @db.VarChar(100)
  statut     String   @default("nouveau") @db.VarChar(50) // "nouveau" | "contacte" | "converti"
  notes      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  interactions Interaction[]

  @@index([statut])
  @@index([nom])
  @@map("prospects")
}

// ----------------------------------------------------------------------------
//  Interactions (appel, email, reunion, note)
//  - supprimer un client supprime ses interactions (Cascade)
//  - supprimer un prospect conserve l'historique (SetNull)
// ----------------------------------------------------------------------------
model Interaction {
  id          String   @id @db.VarChar(64)
  client_id   String?  @db.VarChar(64)
  prospect_id String?  @db.VarChar(64)
  type        String   @db.VarChar(50) // "appel" | "email" | "reunion" | "note"
  sujet       String   @db.VarChar(500)
  contenu     String?  @db.Text
  date        DateTime @default(now()) @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  client   Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  prospect Prospect? @relation(fields: [prospect_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([prospect_id])
  @@index([type])
  @@index([date])
  @@map("interactions")
}

// ----------------------------------------------------------------------------
//  Opportunites commerciales (pipeline de vente)
//  - supprimer un client conserve l'opportunite (SetNull) pour ne pas perdre le CA
// ----------------------------------------------------------------------------
model Opportunity {
  id           String    @id @db.VarChar(64)
  client_id    String?   @db.VarChar(64)
  titre        String    @db.VarChar(500)
  montant      Decimal   @default(0) @db.Decimal(15, 2)
  statut       String    @default("prospection") @db.VarChar(50) // prospection | qualification | proposition | negociation | gagnee | perdue
  description  String?   @db.Text
  date_cloture DateTime? @db.Date
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  client Client? @relation(fields: [client_id], references: [id], onDelete: SetNull)

  @@index([client_id])
  @@index([statut])
  @@index([date_cloture])
  @@map("opportunities")
}

// ----------------------------------------------------------------------------
//  Historique du chatbot assistant
//  Chaque message utilisateur / assistant est conserve avec l'intention detectee
//  par le moteur de reconnaissance et le moteur qui a repondu.
// ----------------------------------------------------------------------------
model ChatMessage {
  id         String   @id @default(uuid()) @db.VarChar(64)
  user_id    String   @db.VarChar(64)
  session_id String   @db.VarChar(64)
  role       String   @db.VarChar(20) // "user" | "assistant"
  content    String   @db.Text
  intent     String?  @db.VarChar(80)
  confidence Float?
  engine     String?  @db.VarChar(40) // "local" | "openai" | "anthropic"
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([session_id])
  @@map("chat_messages")
}
