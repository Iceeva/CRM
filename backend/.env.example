# =============================================================================
#  CRM Pro - Variables d'environnement (backend)
#  Copiez ce fichier en `.env` :  cp .env.example .env
#  Sur Vercel : Project Settings > Environment Variables (memes noms).
#  Documentation complete : README.md et docs/DEPLOYMENT_VERCEL.md
# =============================================================================

# ----- Serveur (local uniquement) -----
PORT=5000
NODE_ENV=development

# ----- Base de donnees : Neon PostgreSQL via Prisma -----
# Laissez DATABASE_URL vide pour utiliser le mode JSON (aucune base necessaire).
#
# DATABASE_URL : URL POOLEE Neon (l'hote contient "-pooler"). C'est elle que
#                l'application utilise a l'execution, indispensable en serverless.
# DIRECT_URL   : URL DIRECTE Neon (sans "-pooler"). Utilisee seulement par la CLI
#                Prisma pour les migrations.
# Console Neon > Connect > cochez/decochez "Connection pooling" pour obtenir les deux.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Delai minimal (ms) entre deux tests de connexion quand Neon est indisponible
DB_RECHECK_MS=15000

# ----- Authentification -----
# OBLIGATOIRE en production. Generer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ----- CORS -----
# Origines autorisees, separees par des virgules (ex: https://mon-crm.vercel.app).
# Vide : tout est permis en developpement, meme origine uniquement en production.
CORS_ORIGINS=

# ----- Mode de secours JSON -----
# Par defaut : backend/data/data.json (local) ou /tmp/crm-data.json (Vercel, ephemere).
# JSON_STORE_PATH=

# ----- Chatbot assistant -----
CHATBOT_ENABLED=true
# Active la route /api/chatbot/analyze (debug du moteur d'intentions)
CHATBOT_DEBUG=true
# Conserve l'historique des conversations (table chat_messages ou JSON)
CHATBOT_PERSIST_HISTORY=true
# Seuil de confiance (0 a 1) sous lequel le moteur demande une precision
CHATBOT_MIN_CONFIDENCE=0.55
# Ecart minimal entre les 2 meilleures intentions pour ne pas considerer la phrase ambigue
CHATBOT_AMBIGUITY_MARGIN=0.12

# =============================================================================
#  IA OPTIONNELLE : OpenAI et/ou Anthropic (les deux sont facultatifs)
#  Sans cle, le chatbot fonctionne entierement avec son moteur local.
# =============================================================================
# AI_PROVIDER : none | openai | anthropic | auto
#   none      : moteur local uniquement (defaut)
#   openai    : OpenAI (ou API compatible via OPENAI_BASE_URL)
#   anthropic : Anthropic Claude
#   auto      : Anthropic si sa cle existe, sinon OpenAI, sinon local
AI_PROVIDER=none
# AI_MODE : off | fallback | assist
#   off      : l'IA n'est jamais appelee
#   fallback : l'IA n'est appelee que si le moteur local est incertain (defaut)
#   assist   : l'IA reformule toutes les reponses a partir du resultat du moteur local
AI_MODE=fallback
# Si le fournisseur choisi echoue, essayer l'autre (s'il est configure), puis le moteur local
AI_FAILOVER=true
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=600
AI_TEMPERATURE=0.3
# false (defaut) : seules des statistiques agregees sont envoyees a l'IA.
# true : les enregistrements retournes par le moteur local (noms, emails...) sont inclus.
AI_SHARE_CRM_DATA=false

# ----- OpenAI -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Pour Azure OpenAI, OpenRouter, Ollama, etc. (API compatible) :
OPENAI_BASE_URL=https://api.openai.com/v1

# ----- Anthropic -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
